<%- include('partials/header') %>

<section class="hero">
  <div class="wrap hero-inner">
    <div>
      <p class="hero-eyebrow">মেডিকেল ও ডেন্টাল ভর্তি প্রস্তুতি</p>
      <h1>স্বপ্নের সাদা অ্যাপ্রোন এখন হাতের নাগালে</h1>
      <p class="lead">সঠিক গাইডলাইন, নিয়মিত মডেল টেস্ট আর অভিজ্ঞ শিক্ষকদের তত্ত্বাবধানে HSC পরীক্ষার্থীদের মেডিকেল ও ডেন্টাল কলেজ ভর্তি পরীক্ষার জন্য প্রস্তুত করা হয়।</p>
      <div class="hero-actions">
        <a href="/courses" class="btn btn-primary">ব্যাচ দেখো</a>
        <a href="/success" class="btn btn-outline">মেধা তালিকা দেখো</a>
      </div>
    </div>

    <div class="admit-card">
      <div class="ac-top">
        <span class="ac-title">প্রবেশপত্র</span>
        <span class="ac-photo"></span>
      </div>
      <dl>
        <dt>ব্যাচ</dt><dd>মেডিকেল সান্ধ্য-১২</dd>
        <dt>রোল</dt><dd>০৪৭</dd>
        <dt>বিষয়</dt><dd>বায়োলজি, কেমিস্ট্রি, ফিজিক্স</dd>
        <dt>মডেল টেস্ট</dt><dd>প্রতি শুক্রবার</dd>
      </dl>
      <p class="ac-stamp">✓ ভর্তি নিশ্চিত</p>
    </div>
  </div>
</section>

<section class="stats">
  <div class="wrap stats-inner">
    <div class="stat"><b>৪৫০+</b><span>মেডিকেল-ডেন্টালে চান্সপ্রাপ্ত শিক্ষার্থী</span></div>
    <div class="stat"><b>১২ বছর</b><span>ভর্তি প্রস্তুতির অভিজ্ঞতা</span></div>
    <div class="stat"><b>৩০+</b><span>অভিজ্ঞ শিক্ষক প্যানেল</span></div>
    <div class="stat"><b>৫০+</b><span>বার্ষিক মডেল টেস্ট</span></div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="section-head">
      <h2>ব্যাচ ও কোর্স</h2>
      <p>HSC ব্যাচ, HSC উত্তীর্ণ (রিটেক) এবং শর্ট সাজেশন কোর্স — যার যা প্রয়োজন সেভাবে সাজানো।</p>
    </div>

    <div class="batch-row">
      <div class="batch-name">HSC একাডেমিক ব্যাচ<small>একাদশ-দ্বাদশ, ২ বছর মেয়াদী</small></div>
      <div class="batch-desc">HSC সিলেবাসের পাশাপাশি মেডিকেল ভর্তি পরীক্ষার ভিত্তি তৈরি — সপ্তাহে ৬ দিন ক্লাস।</div>
      <div class="batch-fee">৳ ৫,০০০<span>মাসিক</span></div>
    </div>
    <div class="batch-row">
      <div class="batch-name">HSC উত্তীর্ণ ইন্টেনসিভ<small>৬ মাস মেয়াদী</small></div>
      <div class="batch-desc">HSC পরীক্ষার পর থেকে ভর্তি পরীক্ষা পর্যন্ত সার্বক্ষণিক প্রস্তুতি, নিয়মিত মডেল টেস্ট সহ।</div>
      <div class="batch-fee">৳ ২৫,০০০<span>পূর্ণ কোর্স</span></div>
    </div>
    <div class="batch-row">
      <div class="batch-name">শেষ মুহূর্তের সাজেশন<small>১ মাস মেয়াদী</small></div>
      <div class="batch-desc">পরীক্ষার আগে দ্রুত রিভিশন, শর্ট সাজেশন ও একাধিক ফাইনাল মডেল টেস্ট।</div>
      <div class="batch-fee">৳ ৩,৫০০<span>পূর্ণ কোর্স</span></div>
    </div>

    <p style="margin-top:28px;"><a href="/courses" class="btn btn-primary">সব ব্যাচ ও বিস্তারিত ফি দেখো</a></p>
  </div>
</section>

<section class="alt">
  <div class="wrap">
    <div class="section-head">
      <h2>মেধা তালিকা থেকে</h2>
      <p>আমাদের ছাত্রছাত্রীরা যেসব সরকারি মেডিকেল ও ডেন্টাল কলেজে চান্স পেয়েছে, তার কয়েকটি উদাহরণ।</p>
    </div>

    <ul class="merit-list">
      <li class="merit-row">
        <span class="merit-rank">০১</span>
        <span class="merit-photo">ফ</span>
        <span class="merit-name">ফারহানা আক্তার<small>মেডিকেল ব্যাচ ২০২৪</small></span>
        <span class="merit-college">ঢাকা মেডিকেল কলেজ</span>
      </li>
      <li class="merit-row">
        <span class="merit-rank">০২</span>
        <span class="merit-photo">র</span>
        <span class="merit-name">রাকিবুল হাসান<small>মেডিকেল ব্যাচ ২০২৪</small></span>
        <span class="merit-college">স্যার সলিমুল্লাহ মেডিকেল কলেজ</span>
      </li>
      <li class="merit-row">
        <span class="merit-rank">০৩</span>
        <span class="merit-photo">ন</span>
        <span class="merit-name">নুসরাত জাহান<small>ডেন্টাল ব্যাচ ২০২৪</small></span>
        <span class="merit-college">ঢাকা ডেন্টাল কলেজ</span>
      </li>
    </ul>

    <p style="margin-top:28px;"><a href="/success" class="btn btn-outline" style="border-color:var(--primary);color:var(--primary-dark);">পূর্ণ মেধা তালিকা দেখো</a></p>
  </div>
</section>

<section class="cta-band">
  <div class="wrap">
    <h2>আজই ভর্তি হও, প্রস্তুতি শুরু করো</h2>
    <p>সীমিত আসন — নতুন ব্যাচ শুরুর আগেই নিশ্চিত করো।</p>
    <a href="/contact" class="btn btn-primary">যোগাযোগ করো</a>
  </div>
</section>

<%- include('partials/footer') %>
